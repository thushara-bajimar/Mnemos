# Copy to .env (never commit .env). All settings are optional.
# MNEMOS_API_KEY=change-me            # if set, every /api request needs header X-API-Key
# MNEMOS_DATA_DIR=backend/data
# MNEMOS_CORS_ORIGINS=http://localhost:5173
# MNEMOS_CONFIRMATION_THRESHOLD=0.55
# MNEMOS_ABSTAIN_THRESHOLD=0.22
# MNEMOS_DEFAULT_TOKEN_BUDGET=1000
# MNEMOS_FORCE_ESTIMATE_TOKENIZER=false
